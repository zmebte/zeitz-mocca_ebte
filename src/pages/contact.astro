---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadInformationPage } from "../sanity/lib/loadInformationPage";
import { renderInlinePortableText } from "../sanity/lib/renderInlinePortableText";
import dotLogoUrl from "../assets/zeitz-logo-icon_dark.svg?url";

const page = await loadInformationPage("contactPage", Astro.cookies);
---

<BaseLayout
  title={`${page.title} | Everything but the Exhibition`}
  description={page.seoDescription}
>
  <main class="contact-page">
    <section class="contact-page__content" aria-labelledby="contact-title">
      <div class="contact-page__body">
        {page.intro.map((block) => (
          <p class="contact-page__intro" set:html={renderInlinePortableText([block])} />
        ))}
      </div>

      <div class="contact-page__footer">
        <h1 class="contact-page__title" id="contact-title">{page.title}</h1>
        <a
          class="contact-page__mark-link"
          href="/"
          aria-label="Everything but the Exhibition home"
        >
          <img
            class="contact-page__mark"
            src={dotLogoUrl}
            alt=""
            aria-hidden="true"
          />
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page__footer {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .contact-page {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: clip;
    padding: 1.5rem;
    background: var(--surface);
    color: var(--ink);
    display: flex;
    align-items: flex-end;
  }

  .contact-page__content {
    display: flex;
    flex-direction: column;
    height: min(75svh, calc(100svh - 3rem));
    max-height: 75svh;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
  }

  .contact-page__body {
    display: grid;
    gap: 2rem;
    min-height: 0;
  }

  .contact-page__intro {
    overflow-wrap: anywhere;
    max-width: 56rem;
    margin: 0;
    font: 400 clamp(1.5rem, 2.5vw, 2.25rem) / 1 var(--font-display);
    letter-spacing: 0;
  }

  .contact-page__intro :global(em) {
    text-shadow: var(--text-shadow-hover-large-black);
  }

  .contact-page__intro :global(a) {
    color: inherit;
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.12em;
    transition: var(--transition-text-shadow);
  }

  .contact-page__intro :global(a:hover),
  .contact-page__intro :global(a:focus-visible) {
    text-shadow: var(--text-shadow-hover-large-black);
  }

  .contact-page__intro :global(a:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 0.25rem;
  }

  .contact-page__title {
    margin: 0;
    max-width: calc(100% - 10rem);
    font: 400 clamp(3.25rem, 12vw, 17rem) / 0.8 var(--font-display);
    letter-spacing: -0.05em;
    padding: 0.25rem;
  }

  .contact-page__mark {
    width: clamp(2rem, 6vw, 6rem);
    height: auto;
  }

  .contact-page__mark-link {
    display: inline-flex;
    line-height: 0;
  }

  .contact-page__mark-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.35rem;
  }

  @media (max-width: 900px) {
    .contact-page {
      padding: 8rem 1rem 1rem;
      align-items: space-between;
    }

    .contact-page__title {
      font: 400 clamp(3.25rem, 20vw, 17rem) / 0.8 var(--font-display);
      padding: 0;
    }

    .contact-page__intro{
    font: 400 clamp(1.25rem, 2.5vw, 2.25rem) / 1.2 var(--font-display);
    }

    .contact-page__content {
      height: min(75svh, calc(100svh - 6.5rem));
    }

    .contact-page__mark-link {
      position: fixed;
      top: 1rem;
      left: 1rem;
    }

    .contact-page__mark {
      width: clamp(3rem, 8vw, 8rem);
      height: auto;
    }

    .contact-page__intro {
      max-width: 90%;
    }
  }
</style>
