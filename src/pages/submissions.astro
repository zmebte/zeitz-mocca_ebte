---
import BaseLayout from "../layouts/BaseLayout.astro";
import dotLogoUrl from "../assets/zeitz-logo-icon_dark.svg?url";
---

<BaseLayout
  title="Submissions | Everything but the Exhibition"
  description="Submission guidelines for Everything but the Exhibition."
>
  <main class="submissions-page">
    <section
      class="submissions-page__content"
      aria-labelledby="submissions-title"
    >
      <div class="submissions-page__body" data-lenis-prevent>
        <p class="submissions-page__intro">
          We welcome submissions that explore publishing and paracuratorial
          practices within Foot Notes or Voice Notes formats for <em
            >Everything but the Exhibition.</em
          >
        </p>
        <p class="submissions-page__intro">
          Submissions should be sent to <a
            href="mailto:info.everything@zeitzmocaa.museum"
            >info.everything@zeitzmocaa.museum</a
          >
        </p>
        <ul class="submissions-page__guidelines">
          <li>
            Submissions imply final texts. Unfortunately, we are unable to
            accept proposals at this stage.
          </li>
          <li>
            Your text submission should be accompanied by a CV, bio and
            portfolio.
          </li>
          <li>
            When texts require accompanying images, please ensure these are
            original images you have ownership to. We cannot accept
            reproductions of images, images where rights are required, or any
            work that is not your own.
          </li>
          <li>
            Foot Notes submissions should be no more than 2000 words and
            critically engage with the subject matter. These longer-form texts
            explicate a topic through rigorous research.
          </li>
          <li>
            Voice Notes submissions are experimental, subjective forms of
            writing of no more than 500 words to accompany a visual or sonic
            component. We also welcome book reviews in this format.
          </li>
          <li>
            Submissions do not guarantee publication. Decisions will be
            communicated to successful submissions upon review.
          </li>
        </ul>
      </div>
      <div class="submissions-page__footer">
        <h1 class="submissions-page__title" id="submissions-title">
          Submissions
        </h1>
        <a
          class="submissions-page__mark-link"
          href="/"
          aria-label="Everything but the Exhibition home"
        >
          <img
            class="submissions-page__mark"
            src={dotLogoUrl}
            alt=""
            aria-hidden="true"
          />
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .submissions-page__footer {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-items: baseline;
  }
  .submissions-page {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: clip;
    padding: 1.5rem;
    background: var(--ink);
    color: var(--surface);
    display: flex;
    align-items: flex-end;
  }

  .submissions-page__content {
    display: flex;
    flex-direction: column;
    height: min(75svh, calc(100svh - 3rem));
    max-height: 75svh;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
  }

  .submissions-page__body {
    display: grid;
    gap: 2rem;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #fff transparent;
  }

  @supports selector(::-webkit-scrollbar) {
    .submissions-page__body {
      /* Allow the custom scrollbar styles to control the shape and width. */
      scrollbar-width: auto;
      scrollbar-color: auto;
    }
  }

  .submissions-page__body::-webkit-scrollbar {
    width: 3px;
  }

  .submissions-page__body::-webkit-scrollbar-track {
    background: transparent;
  }

  .submissions-page__body::-webkit-scrollbar-thumb {
    background: #fff;
    border-radius: 0;
  }

  .submissions-page__intro {
    max-width: 79rem;
    margin: 0;
    font: 400 clamp(1.5rem, 2.5vw, 2.25rem) / 1 var(--font-display);
    letter-spacing: 0;
    text-wrap: balance;
    transition: var(--transition-text-shadow);
  }

  .submissions-page__intro a:hover {
    text-shadow: var(--text-shadow-hover-large-white);
  }

  .submissions-page__intro em {
    text-shadow: var(--text-shadow-hover-large-white);
  }

  .submissions-page__guidelines {
    max-width: 50rem;
    margin: 0;
    padding-left: 1.5rem;
    font: 400 clamp(1.25rem, 1vw, 1.55rem) / 1.15 var(--font-display);
    letter-spacing: 0;
  }

  .submissions-page__guidelines li {
    padding-left: 0.25rem;
  }

  .submissions-page__title {
    margin: 0;
    max-width: calc(100% - 10rem);
    font: 400 clamp(3.25rem, 12vw, 17rem) / 0.8 var(--font-display);
    letter-spacing: -0.05em;
    padding: 0.25rem;
  }

  .submissions-page__mark {
    height: auto;
    filter: invert(1);
    width: clamp(2rem, 6vw, 6rem);
  }

  .submissions-page__mark-link {
    display: inline-flex;
    line-height: 0;
  }

  .submissions-page__mark-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.35rem;
  }

  /* @media (max-width: 1100px) {
    .submissions-page {
      min-height: 100svh;
      padding-top: 8rem;
      overflow: visible;
    }

    .submissions-page__content {
      position: relative;
      left: auto;
      top: auto;
      width: min(100%, 68rem);
      padding-bottom: clamp(10rem, 28vw, 16rem);
    }

    .submissions-page__title {
      font-size: clamp(5.25rem, 16vw, 10rem);
    }
  } */

  @media (max-width: 900px) {
    .submissions-page {
      padding: 8rem 1rem 1rem;
      align-items: space-between;
    }

    .submissions-page__body {
      gap: 1rem;
    }

  .submissions-page__intro {
    font: 400 clamp(1.25rem, 2.5vw, 2.25rem) / 1.2 var(--font-display);
  }

    .submissions-page__content {
      height: min(75svh, calc(100svh - 6.5rem));
      gap: 1rem;
    }

    .submissions-page__guidelines {
      max-width: none;
      font: 400 clamp(1rem, 1vw, 1.55rem) / 1.15 var(--font-display);
      padding-left: 1rem;
    }

    .submissions-page__title {
      max-width: 0;
      font: 400 clamp(3.25rem, 20vw, 17rem) / 0.8 var(--font-display);
      padding: 0;
    }

    .submissions-page__mark-link {
      position: fixed;
      top: 1rem;
      left: 1rem;
    }

    .submissions-page__mark {
      width: clamp(3rem, 8vw, 8rem);
      height: auto;
    }
  }
</style>
