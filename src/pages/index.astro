---
import HomeArticleIndexSection from "../components/home/HomeArticleIndexSection.astro";
import HomeCategoryCardsSection from "../components/home/HomeCategoryCardsSection.astro";
import HomeFeaturedArticleSection from "../components/home/HomeFeaturedArticleSection.astro";
import HomeHeaderSection from "../components/home/HomeHeaderSection.astro";
import HomeQuoteSection from "../components/home/HomeQuoteSection.astro";
import HomeSplitFeatureSection from "../components/home/HomeSplitFeatureSection.astro";
import DisableDraftMode from "../components/DisableDraftMode";
import SiteFooter from "../components/SiteFooter.astro";
import SanityVisualEditing from "../components/SanityVisualEditing";
import heroPaperSvg from "../assets/home/hero-paper.svg?raw";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDraftModeProps } from "../sanity/lib/draft-mode";
import { cleanString } from "../sanity/lib/clean";
import { loadArticleIndex } from "../sanity/lib/loadArticleIndex";
import { loadHomePage } from "../sanity/lib/loadHomePage";

const draftMode = Boolean(getDraftModeProps(Astro.cookies).perspectiveCookie);

const [homePage, articles] = await Promise.all([
  loadHomePage(Astro.cookies),
  loadArticleIndex(Astro.cookies),
]);

const pageTitle =
  cleanString(homePage.headerTitle) || "Everything but the Exhibition";
const pageDescription =
  cleanString(homePage.seoDescription) ||
  "Recent articles from Everything but the Exhibition.";
const responsiveHeroPaperSvg = heroPaperSvg.includes("preserveAspectRatio=")
  ? heroPaperSvg.replace(
      /preserveAspectRatio="[^"]*"/,
      'preserveAspectRatio="none"',
    )
  : heroPaperSvg.replace("<svg", '<svg preserveAspectRatio="none"');
const hasCategoryCardsSection = homePage.sections.some(
  (section) => section._type === "categoryCardsSection",
);
const hasHeaderSection = homePage.sections.some(
  (section) => section._type === "homeHeaderSection",
);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="home-page">
    <header class="home-hero">
      <h1 class="home-hero__sr-title">{pageTitle}</h1>

      <div class="home-hero__overlay" aria-hidden="true">
        <div class="home-hero__paper" set:html={responsiveHeroPaperSvg} />
        <div class="home-hero__title-mask">
          <div class="home-hero__title home-hero__title--overlay">
            <span class="home-hero__title-line home-hero__title-line--top"
              >Everything but</span
            >
          </div>
        </div>
      </div>

      <div class="home-hero__underlay" aria-hidden="true">
        <div class="home-hero__title home-hero__title--underlay">
          <span class="home-hero__title-line home-hero__title-line--bottom"
            >the Exhibition</span
          >
        </div>
      </div>
    </header>

    {!hasHeaderSection && <HomeHeaderSection />}
    {!hasCategoryCardsSection && <HomeCategoryCardsSection />}

    <div class="home-page__sections">
      {
        homePage.sections.map((section) => (
          <>
            {section._type === "homeHeaderSection" && (
              <HomeHeaderSection section={section} />
            )}
            {section._type === "categoryCardsSection" && (
              <HomeCategoryCardsSection section={section} />
            )}
            {section._type === "articleIndexSection" && (
              <HomeArticleIndexSection section={section} articles={articles} />
            )}
            {section._type === "homeQuoteSection" && (
              <HomeQuoteSection section={section} />
            )}
            {section._type === "homeFeaturedArticleSection" && (
              <HomeFeaturedArticleSection section={section} />
            )}
            {section._type === "homeSplitFeatureSection" && (
              <HomeSplitFeatureSection section={section} />
            )}
          </>
        ))
      }
    </div>
  </main>
  <SiteFooter />
  {draftMode && <SanityVisualEditing client:only="react" />}
  {draftMode && <DisableDraftMode client:only="react" />}
</BaseLayout>

<script is:inline data-astro-rerun>
  (() => {
    if (!window.__initHomeHeroIntroScroll) {
      window.__initHomeHeroIntroScroll = () => {
        const titleLines = document.querySelectorAll(
          ".home-hero__title-line--top, .home-hero__title-line--bottom",
        );

        const scrollIntroIntoView = () => {
          const introSection = document.querySelector(".home-hero__intro");

          if (!introSection) return;

          const introRect = introSection.getBoundingClientRect();
          const maxScrollTop =
            document.documentElement.scrollHeight - window.innerHeight;
          const targetScrollTop = Math.min(
            Math.max(0, introRect.bottom + window.scrollY - window.innerHeight),
            Math.max(0, maxScrollTop),
          );
          const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;

          window.scrollTo({
            top: targetScrollTop,
            behavior: prefersReducedMotion ? "auto" : "smooth",
          });
        };

        titleLines.forEach((titleLine) => {
          if (!(titleLine instanceof HTMLElement) || titleLine.dataset.homeIntroScrollBound === "true") {
            return;
          }

          titleLine.dataset.homeIntroScrollBound = "true";
          titleLine.addEventListener("click", scrollIntroIntoView);
        });
      };

      document.addEventListener("astro:page-load", window.__initHomeHeroIntroScroll);
    }

    window.__initHomeHeroIntroScroll();
  })();
</script>

<style>
  .home-page {
    min-height: 100vh;
    background: var(--page-bg);
  }

  .home-hero {
    --home-hero-paper-height: clamp(0rem, 52svh, 99rem);
    --home-hero-paper-opacity: 0.99;
    --home-hero-title-mask-y: -0.45rem;
    position: relative;
    min-height: 125svh;
    overflow: clip;
    background: var(--ink);
    color: var(--surface);
    isolation: isolate;
    z-index: 999;
  }

  .home-hero__sr-title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
    white-space: nowrap;
  }

  .home-hero__overlay {
    position: sticky;
    top: 0;
    z-index: 1;
    height: var(--home-hero-paper-height);
  }

  .home-hero__paper {
    position: absolute;
    inset: 0 -1px auto;
    z-index: 1;
    height: var(--home-hero-paper-height);
    overflow: visible;
  }

  .home-hero__paper :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: fill;
    opacity: var(--home-hero-paper-opacity);
  }

  .home-hero__title {
    margin: 0;
  }

  .home-hero__title {
    position: absolute;
    left: 50%;
    display: grid;
    width: min(100%, 80rem);
    transform: translate(-50%, -50%);
    font: 400 clamp(4.7rem, 12.5vw, 11.25rem) / 0.85 var(--font-display);
    letter-spacing: -0.025em;
    text-align: center;
    white-space: nowrap;
  }

  .home-hero__title--overlay {
    z-index: 2;
    top: calc(clamp(0rem, 52svh, 99rem) - clamp(0rem, 8vw, 6rem));
  }

  .home-hero__title-mask {
    position: absolute;
    inset: 0;
    z-index: 2;
    height: var(--home-hero-paper-height);
    overflow: hidden;
    -webkit-mask-image: url("/assets/home/header-title-line-1.svg");
    mask-image: url("/assets/home/header-title-line-1.svg");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center var(--home-hero-title-mask-y);
    mask-position: center var(--home-hero-title-mask-y);
  }

  .home-hero__underlay {
    position: relative;
    z-index: 0;
    min-height: 100svh;
    margin-top: calc(-1 * var(--home-hero-paper-height));
  }

  .home-hero__title--underlay {
    z-index: 0;
    top: calc(clamp(0rem, 52svh, 99rem) + clamp(0rem, 7vw, 1rem));
  }

  .home-hero__title-line {
    display: block;
  }

  .home-hero__title-line--top {
    color: var(--ink);
    cursor: pointer;
    transition: var(--transition-text-shadow);
  }

  .home-hero__title:hover .home-hero__title-line--top {
    text-shadow: var(--text-shadow-hover-large-black);
  }

  .home-hero__title:hover .home-hero__title-line--bottom {
    text-shadow: var(--text-shadow-hover-large-white);
  }

  .home-hero__title-line--bottom {
    color: var(--surface);
    cursor: pointer;
    mix-blend-mode: difference;
    transition: var(--transition-text-shadow);
  }

  .home-page__sections {
    display: grid;
    min-height: 100svh;
    align-items: start;
  }

  @media (max-width: 900px) {
    .home-hero {
      --home-hero-paper-height: 48svh;
      --home-hero-title-mask-y: -0.3rem;
      min-height: 140svh;
    }

    .home-hero__title {
      width: 100%;
      padding-inline: 1rem;
      font-size: clamp(3rem, 15vw, 7rem);
      white-space: normal;
    }

    .home-hero__title--overlay {
      top: calc(clamp(0rem, 52svh, 99rem) - clamp(0rem, 18vw, 5.5rem));
    }

    .home-hero__title--underlay {
      top: calc(clamp(0rem, 52svh, 99rem) - clamp(0rem, 11vw, 2rem));
    }

    .home-hero__underlay {
      margin-top: calc(-1 * var(--home-hero-paper-height));
    }
  }

</style>
