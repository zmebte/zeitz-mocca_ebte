<div class="cookie-consent" data-cookie-consent hidden>
  <div class="cookie-consent__copy">
    <p class="cookie-consent__title">Cookie consent</p>
    <p>
      We use essential site storage and privacy-focused analytics to understand
      how the publication is read. Comments may load content from Open Remark.
    </p>
  </div>
  <div class="cookie-consent__actions">
    <button type="button" data-cookie-consent-decline>Decline</button>
    <button type="button" data-cookie-consent-accept>Accept</button>
  </div>
</div>

<script>
  import { inject, pageview } from "@vercel/analytics";

  const consentKey = "ebte_cookie_consent";
  const acceptedValue = "accepted";
  const declinedValue = "declined";

  declare global {
    interface Window {
      __ebteAnalyticsLoaded?: boolean;
      __ebteAnalyticsLastPath?: string;
      __ebteCookieConsentBound?: boolean;
    }
  }

  const getConsent = () => {
    try {
      return window.localStorage.getItem(consentKey);
    } catch {
      return null;
    }
  };

  const setConsent = (value: string) => {
    try {
      window.localStorage.setItem(consentKey, value);
    } catch {
      // Storage may be unavailable in strict/private browser contexts.
    }
  };

  const getCurrentPath = () => {
    return `${window.location.pathname}${window.location.search}`;
  };

  const trackCurrentPage = () => {
    const path = getCurrentPath();

    if (window.__ebteAnalyticsLastPath === path) {
      return;
    }

    window.__ebteAnalyticsLastPath = path;
    pageview({ path });
  };

  const loadAnalytics = () => {
    if (!window.__ebteAnalyticsLoaded) {
      window.__ebteAnalyticsLoaded = true;
      inject({
        disableAutoTrack: true,
        framework: "astro",
      });
    }

    trackCurrentPage();
  };

  const hideBanner = () => {
    document
      .querySelectorAll<HTMLElement>("[data-cookie-consent]")
      .forEach((banner) => {
        banner.hidden = true;
      });
  };

  const showBanner = () => {
    document
      .querySelectorAll<HTMLElement>("[data-cookie-consent]")
      .forEach((banner) => {
        banner.hidden = false;
      });
  };

  const syncConsentState = () => {
    const consent = getConsent();

    if (consent === acceptedValue) {
      hideBanner();
      loadAnalytics();
      return;
    }

    if (consent === declinedValue) {
      hideBanner();
      return;
    }

    showBanner();
  };

  const bindConsentControls = () => {
    document
      .querySelectorAll<HTMLElement>("[data-cookie-consent-accept]")
      .forEach((button) => {
        if (button.dataset.cookieConsentBound === "true") {
          return;
        }

        button.dataset.cookieConsentBound = "true";
        button.addEventListener("click", () => {
          setConsent(acceptedValue);
          hideBanner();
          loadAnalytics();
        });
      });

    document
      .querySelectorAll<HTMLElement>("[data-cookie-consent-decline]")
      .forEach((button) => {
        if (button.dataset.cookieConsentBound === "true") {
          return;
        }

        button.dataset.cookieConsentBound = "true";
        button.addEventListener("click", () => {
          setConsent(declinedValue);
          hideBanner();
        });
      });

    document
      .querySelectorAll<HTMLElement>("[data-cookie-consent-open]")
      .forEach((button) => {
        if (button.dataset.cookieConsentBound === "true") {
          return;
        }

        button.dataset.cookieConsentBound = "true";
        button.addEventListener("click", (event) => {
          event.preventDefault();
          showBanner();
        });
      });
  };

  const initCookieConsent = () => {
    bindConsentControls();
    syncConsentState();
  };

  initCookieConsent();

  if (!window.__ebteCookieConsentBound) {
    window.__ebteCookieConsentBound = true;
    document.addEventListener("astro:page-load", initCookieConsent);
  }
</script>

<style>
  .cookie-consent {
    position: fixed;
    z-index: 1000;
    left: 1rem;
    bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: end;
    width: min(calc(100vw - 2rem), 30rem);
    padding: 1rem;
    background: var(--ink);
    border: 1px solid var(--surface);
    color: var(--surface);
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 12%);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent__copy {
    display: grid;
    gap: 0.4rem;
  }

  .cookie-consent p {
    margin: 0;
    font: 700 0.65rem / 1.35 var(--font-meta);
    max-width: 90%;
  }

  .cookie-consent__title {
    font-family: var(--font-meta) !important;
    font-weight: 700 !important;
    letter-spacing: var(--meta-letter-spacing);
    text-transform: uppercase;
  }

  .cookie-consent__actions {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }

  .cookie-consent button {
    width: 100%;
    appearance: none;
    border: 1px solid var(--ink);
    border-radius: 0;
    padding: 0.55rem 0.8rem;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    font: 700 0.75rem / 1 var(--font-meta);
    letter-spacing: var(--meta-letter-spacing);
    text-transform: uppercase;
    transition:
      background 160ms ease,
      color 160ms ease,
      text-shadow 160ms ease;
  }

  .cookie-consent button[data-cookie-consent-accept] {
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--surface);
  }

    .cookie-consent button[data-cookie-consent-decline] {
    background: var(--ink);
    color: var(--surface);
    border: 1px solid var(--surface);
  }


  .cookie-consent button:hover,
  .cookie-consent button:focus-visible {
    text-shadow: var(--text-shadow-hover-small-white);
  }

  .cookie-consent button[data-cookie-consent-accept]:hover,
  .cookie-consent button[data-cookie-consent-accept]:focus-visible {
    text-shadow: var(--text-shadow-hover-small-black);
  }

  .cookie-consent button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.2rem;
  }

  @media (max-width: 640px) {
    .cookie-consent {
      left: 1rem;
      right: 1rem;
      grid-template-columns: 1fr;
    }

    .cookie-consent__actions {
      justify-content: stretch;
    }

    .cookie-consent button {
      flex: 1;
    }
  }
</style>
