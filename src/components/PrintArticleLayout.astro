---
import { calculateReadTime } from "../sanity/lib/calculateReadTime";
import { formatAuthorNames } from "../sanity/lib/authors";
import { extractArticleCitations } from "../sanity/lib/citations";
import { cleanString } from "../sanity/lib/clean";
import { extractPullQuoteRuns } from "../sanity/lib/pullQuotes";
import { renderPullQuote } from "../sanity/lib/renderPullQuote";
import { renderInlinePortableText } from "../sanity/lib/renderInlinePortableText";
import { renderPortableText } from "../sanity/lib/renderPortableText";
import type { Article } from "../sanity/lib/types";

const { article } = Astro.props as { article: Article };
const { citationMap, citations } = extractArticleCitations(article.contentSections);

const preventTitleWidow = (value = "") =>
  value.trim().replace(/\s+([^\s]+)$/, "\u00A0$1");

const title = cleanString(article.title);
const displayTitle = preventTitleWidow(title);
const articleSlug = cleanString(article.slug?.current);
const articlePath = articleSlug ? `/articles/${articleSlug}` : "/articles";
const authorName = formatAuthorNames(article);
const publishedAtValue = cleanString(article.publishedAt);
const publishedAt = publishedAtValue
  ? new Intl.DateTimeFormat("en-GB", {
      day: "2-digit",
      month: "long",
      year: "numeric"
    }).format(new Date(publishedAtValue))
  : "";
const readTime = calculateReadTime(article);
const detailLine = [publishedAt, readTime ? `${readTime} read` : ""]
  .filter(Boolean)
  .join("   /   ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title || "Article"}</title>
  </head>
  <body>
    <div class="print-body">
      <header class="masthead">
        <h1 class="masthead__title">{displayTitle}</h1>
        {authorName && <p class="masthead__meta">{authorName}</p>}
        {detailLine && <p class="masthead__meta">{detailLine}</p>}
      </header>

      {article.contentSections.map((section) => {
        if (section._type === "richTextSection") {
          const html = renderPortableText(section.body, citationMap);
          const placement = cleanString(section.pullQuotePlacement) || "top";
          const extractedQuotes = extractPullQuoteRuns(section.body);
          const quoteBlocks = extractedQuotes.map((pullQuote) => (
            <figure class="print-pull-quote print-pull-quote--inline">
              <blockquote>{pullQuote.quote}</blockquote>
            </figure>
          ));

          return (
            <>
              {placement === "top" && quoteBlocks}
              <div class="print-prose" set:html={html} />
              {placement === "bottom" && quoteBlocks}
            </>
          );
        }

        if (section._type === "pullQuoteSection") {
          const quoteHtml = renderPullQuote(section.quote, citationMap);
          const attribution = cleanString(section.attribution);
          return (
            <figure class={`print-pull-quote print-pull-quote--${section.size || "normal"}`}>
              <blockquote set:html={quoteHtml} />
              {attribution && <figcaption>— {attribution}</figcaption>}
            </figure>
          );
        }

        if (section._type === "imageSection") {
          const url = cleanString(section.image?.url);
          const captionHtml = renderInlinePortableText(section.image?.formattedCaption);
          const alt = cleanString(section.image?.alt);

          if (!url) {
            return null;
          }

          return (
            <figure class="print-image">
              <img src={url} alt={alt} />
              {captionHtml && <figcaption set:html={captionHtml} />}
            </figure>
          );
        }

        if (section._type === "audioPlayerSection") {
          const audioTitle = cleanString(section.title) || title || "this audio";

          return (
            <p class="print-audio-link">
              Visit this link to listen to <span>&ldquo;{audioTitle}&rdquo;</span>:{" "}
              <a href={articlePath}>{articlePath}</a>
            </p>
          );
        }

        if (section._type === "dividerSection") {
          if (cleanString(section.style) === "space") {
            return <div class="print-spacer" />;
          }
          return <hr class="print-divider" />;
        }

        return null;
      })}

      {citations.length > 0 && (
        <section class="print-citations" aria-labelledby="print-citations-title">
          <h2 id="print-citations-title">Citations</h2>
          <ol>
            {citations.map((citation) => (
              <li id={citation.id}>
                <span class="print-citations__source" set:html={citation.sourceHtml} />
                {citation.url && <span class="print-citations__url"> {citation.url}</span>}
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>

  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 30pt 28pt;
  }

  :root {
    --font-display: "TeX Gyre Termes", "Times New Roman", Times, serif;
    --font-body: "TeX Gyre Schola", "Century Schoolbook", Georgia, serif;
    --font-meta: "TeX Gyre Cursor", "Courier New", Courier, monospace;
    --meta-letter-spacing: 0.04em;
    --baseline: 7pt;
    --ink: #171717;
    --muted: rgba(23, 23, 23, 0.7);
    --line: rgba(23, 23, 23, 0.25);
  }

  @font-face {
    font-family: "TeX Gyre Termes";
    src: url("/fonts/webfonts/texgyretermes-regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: "TeX Gyre Termes";
    src: url("/fonts/webfonts/texgyretermes-bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
  }
  @font-face {
    font-family: "TeX Gyre Termes";
    src: url("/fonts/webfonts/texgyretermes-italic.woff2") format("woff2");
    font-weight: 400;
    font-style: italic;
  }
  @font-face {
    font-family: "TeX Gyre Termes";
    src: url("/fonts/webfonts/texgyretermes-bolditalic.woff2") format("woff2");
    font-weight: 700;
    font-style: italic;
  }
  @font-face {
    font-family: "TeX Gyre Schola";
    src: url("/fonts/webfonts/texgyreschola-regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: "TeX Gyre Schola";
    src: url("/fonts/webfonts/texgyreschola-bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
  }
  @font-face {
    font-family: "TeX Gyre Schola";
    src: url("/fonts/webfonts/texgyreschola-italic.woff2") format("woff2");
    font-weight: 400;
    font-style: italic;
  }
  @font-face {
    font-family: "TeX Gyre Schola";
    src: url("/fonts/webfonts/texgyreschola-bolditalic.woff2") format("woff2");
    font-weight: 700;
    font-style: italic;
  }
  @font-face {
    font-family: "TeX Gyre Cursor";
    src: url("/fonts/webfonts/texgyrecursor-regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: "TeX Gyre Cursor";
    src: url("/fonts/webfonts/texgyrecursor-bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 10.5pt;
    line-height: calc(var(--baseline) * 2);
  }

  img {
    max-width: 100%;
    display: block;
  }

  .masthead {
    margin: 0 0 calc(var(--baseline) * 4) 0;
    text-align: center;
  }

  .masthead__title {
    margin: 0 0 calc(var(--baseline) * 2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24pt;
    line-height: calc(var(--baseline) * 3);
    letter-spacing: -0.02em; 
  }

  .masthead__meta {
    margin: 0;
    font-family: var(--font-meta);
    font-size: 7pt;
    font-weight: 600;
    line-height: calc(var(--baseline) * 1.5);
    color: var(--muted);
    letter-spacing: var(--meta-letter-spacing);
  }

  /* .masthead__meta + .masthead__meta {
    margin-top: var(--baseline);
  } */

  .print-body {
    column-count: 2;
    column-gap: 24pt;
  }

  .print-prose {
    orphans: 3;
    widows: 3;
  }

  .print-prose p,
  .print-prose li {
    margin: 0 0 var(--baseline);
    font-size: 10.5pt;
    line-height: calc(var(--baseline) * 2);
  }

  .print-prose h2,
  .print-prose h3 {
    column-span: all;
    font-family: var(--font-display);
    font-weight: 700;
    margin: calc(var(--baseline) * 2) 0 var(--baseline);
    line-height: calc(var(--baseline) * 2);
  }

  .print-prose h2 {
    font-size: 15pt;
  }

  .print-prose h3 {
    font-size: 12pt;
  }

  .print-prose blockquote {
    margin: var(--baseline) 0 var(--baseline) 14pt;
    padding-left: 10pt;
    border-left: 2pt solid var(--ink);
    color: var(--muted);
  }

  .print-prose ul,
  .print-prose ol {
    margin: 0 0 var(--baseline);
    padding-left: 16pt;
  }

  .print-prose code {
    font-family: var(--font-meta);
    font-size: 0.92em;
    letter-spacing: var(--meta-letter-spacing);
  }

  .print-prose .u-interview {
    float: inline-start;
    margin-bottom: 7pt;
    margin-right: 14pt;
  }

  .print-prose .u-citation-target,
  .print-pull-quote .u-citation-target {
    white-space: normal;
  }

  .print-prose .u-citation-ref,
  .print-pull-quote .u-citation-ref {
    font-family: var(--font-meta);
    font-size: 0.56em;
    font-weight: 700;
    letter-spacing: var(--meta-letter-spacing);
    line-height: 0;
  }

  .print-prose .u-citation-ref button,
  .print-pull-quote .u-citation-ref button {
    appearance: none;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .print-prose .u-pull-quote-target {
  }

  .print-pull-quote--inline {
    margin: calc(var(--baseline) * 2) 0;
  }

  .print-divider,
  .print-spacer {
    column-span: all;
  }

  .print-pull-quote {
    margin: calc(var(--baseline) * 1.5) 0 calc(var(--baseline) * 2);
    padding: var(--baseline) 10pt;
    text-align: center;
  }

  .print-pull-quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 15pt;
    line-height: calc(var(--baseline) * 2.5);
  }

  .print-pull-quote blockquote p {
    margin: 0;
  }
/* 
  .print-pull-quote blockquote p + p {
    margin-top: var(--baseline);
  } */

  .print-pull-quote--large blockquote {
    font-size: 18pt;
    line-height: calc(var(--baseline) * 3);
  }

  .print-pull-quote figcaption {
    margin-top: var(--baseline);
    font-family: var(--font-meta);
    font-size: 8pt;
    font-weight: 700;
    line-height: var(--baseline);
    letter-spacing: var(--meta-letter-spacing);
  }

  .print-image {
    margin: calc(var(--baseline) * 2) 0;
    text-align: center;
  }

  .print-image img {
    max-height: 300pt;
    margin: 0 auto;
  }

  .print-image a {
    color: inherit;
    text-decoration: none;
  }

  .print-image figcaption {
    margin-top: var(--baseline);
    font-family: var(--font-meta);
    font-size: 7pt;
    line-height: var(--baseline);
    color: var(--muted);
    letter-spacing: var(--meta-letter-spacing);
    font-weight: 600;
    padding: 0 16pt;
  }

  .print-audio-link {
    margin: calc(var(--baseline) * 2) 0;
    padding: calc(var(--baseline) * 2) 0;
    border-top: 0.5pt solid var(--line);
    border-bottom: 0.5pt solid var(--line);
    font-family: var(--font-meta);
    font-size: 7pt;
    font-weight: 600;
    line-height: calc(var(--baseline) * 1.5);
    letter-spacing: var(--meta-letter-spacing);
    color: var(--muted);
    text-align: center;
  }

  .print-audio-link span {
    color: var(--ink);
  }

  .print-audio-link a {
    color: var(--ink);
    text-decoration: none;
    word-break: break-word;
  }

  .print-citations {
    margin: calc(var(--baseline) * 3) 0 0;
    padding-top: var(--baseline);
  }

  .print-citations h2 {
    margin: 0 0 var(--baseline);
    font-family: var(--font-meta);
    font-size: 6pt;
    font-weight: 700;
    line-height: var(--baseline);
    letter-spacing: var(--meta-letter-spacing);
    text-transform: uppercase;
  }

  .print-citations ol {
    margin: 0;
    padding-left: 10pt;
  }

  .print-citations li {
    margin: 0 0 var(--baseline);
    font-family: var(--font-meta);
    font-size: 5.5pt;
    line-height: var(--baseline);
    letter-spacing: var(--meta-letter-spacing);
  }

  .print-citations small,
  .print-citations__url {
    display: block;
    color: var(--muted);
  }

  .print-divider {
    margin: calc(var(--baseline) * 2) 0;
    border: none;
    border-top: 0.75pt solid var(--line);
  }

  .print-spacer {
    height: calc(var(--baseline) * 2);
  }

</style>
