    "guidelines": [
      {
        "_key": "guideline0",
        "_type": "guideline",
        "text": "Submissions imply final texts. Unfortunately, we are unable to accept proposals at this stage."
      },
      {
        "_key": "guideline1",
        "_type": "guideline",
        "text": "Your text submission should be accompanied by a CV, bio and portfolio."
      },
      {
        "_key": "guideline2",
        "_type": "guideline",
        "text": "When texts require accompanying images, please ensure these are original images you have ownership to. We cannot accept reproductions of images, images where rights are required, or any work that is not your own."
      },
      {
        "_key": "guideline3",
        "_type": "guideline",
        "text": "Foot Notes submissions should be no more than 2000 words and critically engage with the subject matter. These longer-form texts explicate a topic through rigorous research."
      },
      {
        "_key": "guideline4",
        "_type": "guideline",
        "text": "Voice Notes submissions are experimental, subjective forms of writing of no more than 500 words to accompany a visual or sonic component. We also welcome book reviews in this format."
      },
      {
        "_key": "guideline5",
        "_type": "guideline",
        "text": "Submissions do not guarantee publication. Decisions will be communicated to successful submissions upon review."
      }
    ]
  },
